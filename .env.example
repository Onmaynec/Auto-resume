# Copy to .env.local for local Vercel development.
# Never commit real values.

# Guest/public GraphQL fallback token.
GITHUB_TOKEN=

# GitHub OAuth App credentials.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Exact callback registered in the OAuth App, for example:
# https://your-domain.example/api/auth/callback
GITHUB_CALLBACK_URL=

# At least 32 random characters. Rotating it invalidates all sessions.
SESSION_SECRET=

# Optional GitHub REST/GraphQL API version override.
GITHUB_API_VERSION=2022-11-28
